    "css-loader": "7.1.4",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "10.2.0",
    "globals": "15.14.0",
    "mini-css-extract-plugin": "2.10.2",
    "npm-run-all": "4.1.5",
    "postcss-loader": "8.2.1",
    "rimraf": "5.0.5",
    "sass": "1.99.0",
    "sass-loader": "16.0.7",
    "stylelint": "15.10.1",
    "stylelint-config-standard-scss": "9.0.0",
    "stylelint-scss": "4.6.0",
    "stylelint-webpack-plugin": "5.1.0",
    "webpack": "5.106.1",
