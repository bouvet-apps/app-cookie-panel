{
  "name": "resources",
  "version": "1.0.0",
  "description": "Back-end resources",
  "scripts": {
    "watch": "babel --watch=src/main/resources --out-dir build/resources/main --ignore \"**/*.js\"",
    "build": "npm-run-all build:*",
    "build:js": "babel src/main/resources --out-dir build/resources/main --ignore \"**/*.js\"",
    "dev": "npm-run-all --parallel watch:*",
    "lint": "eslint src/main/resources/**/*.es6"
  },
  "author": "Bouvet",
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/cli": "8.0.0-rc.3",
    "@babel/core": "8.0.0-rc.3",
    "@babel/eslint-parser": "8.0.0-rc.3",
    "@babel/plugin-transform-nullish-coalescing-operator": "8.0.0-rc.3",
    "@babel/plugin-transform-optional-chaining": "8.0.0-rc.3",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "8.0.0-rc.3",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.19.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.1",
    "deepmerge": "4.3.1",
    "eslint": "10.2.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "28.11.0",
    "globals": "15.14.0",
    "npm-run-all": "4.1.5"
  },
  "dependencies": {
    "mark.js": "8.11.1"
  }
}
